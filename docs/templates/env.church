# ============================================================
# Church deployment branding template
# Usage:  cp docs/templates/env.church .env.local  then edit.
# Never commit .env.local — it is already gitignored.
# ============================================================

# --- Identity ------------------------------------------------

# Product/browser-tab title (shown everywhere as the window name)
VITE_APP_NAME=Grace Community Church Management

# Church name shown in header, login screen, member portal,
# PIN emails, SMS messages and PDF statements
VITE_CHURCH_NAME=Grace Community Church

# Short code used as a logo fallback and brand mark
VITE_CHURCH_SHORT_NAME=GCC

# Logo file in /public — swap public/church-logo.png or point elsewhere
VITE_LOGO_PATH=/church-logo.png

# Public website — enables "Back to <church> Website" in the portal
VITE_CHURCH_WEBSITE=https://gracecommunity.org

# --- Membership ----------------------------------------------

# Member ID prefix used when auto-generating IDs (GCC-001, GCC-002…)
VITE_MEMBER_ID_PREFIX=GCC-

# Domain for auto-generated member email aliases (ImprovMX)
VITE_ORG_EMAIL_DOMAIN=gracecommunity.org

# --- Communication defaults ----------------------------------

# Default SMS sender name (must be registered with Africa's Talking)
VITE_SMS_SENDER_ID=GRACE

# --- Required platform keys ----------------------------------

# Clerk publishable key (safe for browser)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Supabase pg_graphql endpoint
VITE_SUPABASE_GRAPHQL_URL=https://<project-ref>.supabase.co/graphql/v1

# Supabase anon key (safe for browser — protected by RLS)
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Optional services ---------------------------------------

# AI: Cloudflare Worker proxy (keep the Gemini key server-side)
VITE_GEMINI_PROXY_URL=

# SMS backend (NestJS in sms-backend/) for Textbee gateway deployments
VITE_SMS_BACKEND_URL=
